<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp"
    android:paddingTop="@dimen/_3sdp"
    android:paddingBottom="@dimen/_3sdp">

    <LinearLayout
        android:id="@+id/ai_msg_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="280dp"
        tools:layout_gravity="end">

        <!-- 普通文本气泡 -->
        <TextView
            android:id="@+id/ai_msg_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ai_bubble_assistant"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp"
            android:textIsSelectable="true"
            android:visibility="gone"
            tools:text="你好，我是 Air AI 助手"
            tools:visibility="visible" />

        <!-- 工具调用/结果卡片 -->
        <LinearLayout
            android:id="@+id/ai_tool_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ai_tool_card"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_6sdp"
            android:minWidth="@dimen/_120sdp"
            android:maxWidth="280dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/ai_tool_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/air_edge_blue"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:maxWidth="260dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="🔧 read_latest_log" />

            <TextView
                android:id="@+id/ai_tool_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_10ssp"
                android:maxWidth="260dp"
                android:ellipsize="end"
                android:maxLines="4"
                tools:text="（内容过长已截断…）" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
